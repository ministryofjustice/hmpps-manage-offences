{% extends "partials/layout.njk" %}
{% from "partials/nav.njk" import navBar with context %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}

{% set pageTitle = applicationName + " - Manage schedules" %}
{% set pageId = "manage-schedules" %}

{% block navBar %}
    {{ navBar("manage-schedules") }}
{% endblock %}

{% block aside %}
    {{ govukBreadcrumbs({
        items: [
            { text: "Schedules", href: "/schedules" },
            { text: "Manage schedules" }
        ]
    }) }}
{% endblock %}

{% block content %}
    <h1 class="govuk-heading-l">Manage schedules</h1>
    <p class="govuk-body">
        Draft schedules are only visible to users with the admin role. Publishing a schedule makes it visible to
        everyone, including any offences already linked to it.
    </p>

    <table class="govuk-table" data-qa="manage-schedules-table">
        <thead class="govuk-table__head">
            <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Schedule</th>
                <th scope="col" class="govuk-table__header">Status</th>
                <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Action</span></th>
            </tr>
        </thead>
        <tbody class="govuk-table__body">
            {% for schedule in schedules %}
                <tr class="govuk-table__row">
                    <td class="govuk-table__cell">
                        <a class="govuk-link" href="/schedules/parts-and-offences/{{ schedule.id }}">{{ schedule.fullName }}</a>
                    </td>
                    <td class="govuk-table__cell">
                        {% if schedule.status === "DRAFT" %}
                            {{ govukTag({ text: "Draft", classes: "govuk-tag--grey" }) }}
                        {% else %}
                            {{ govukTag({ text: "Published", classes: "govuk-tag--green" }) }}
                        {% endif %}
                    </td>
                    <td class="govuk-table__cell">
                        <form method="post" action="/schedules/{{ schedule.id }}/status">
                            <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
                            <input type="hidden" name="status" value="{{ "LIVE" if schedule.status === "DRAFT" else "DRAFT" }}" />
                            {{ govukButton({
                                text: "Publish" if schedule.status === "DRAFT" else "Return to draft",
                                classes: "govuk-button--secondary govuk-!-margin-bottom-0",
                                preventDoubleClick: true,
                                attributes: { "data-qa": "status-" + schedule.id }
                            }) }}
                        </form>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
